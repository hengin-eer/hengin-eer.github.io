{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 80,
  "endOfLine": "lf",
  "ignorePatterns": [
    "**/*.astro",
    "**/*.md",
    "package-lock.json",
    ".astro/**",
    "dist/**",
    "storybook-static/**",
    "test-results/**",
    "playwright-report/**",
    "node_modules/**",
    "src/blogs/**",
    "src/works/**"
  ]
}
