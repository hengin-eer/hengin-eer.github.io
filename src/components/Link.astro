---
interface Props {
  href: string;
  className?: string;
  style?: string;
  ariaLabel?: string;
}

const { href, className, style, ariaLabel } = Astro.props;
---

<a
  href={href}
  class={className}
  style={style}
  aria-label={ariaLabel}
  target="_blank"
  rel="noopener noreferrer"
>
  <slot />
</a>
