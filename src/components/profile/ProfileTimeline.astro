---
import { profileTimeline } from "../../data/profile";

const { id = "timeline" } = Astro.props;
---

<section
  id={id}
  class="profile-section profile-timeline"
  data-ocean-depth="0.48"
>
  <div class="profile-section__inner">
    <div class="profile-section__heading">
      <p class="profile-eyebrow">OPEN WATER / 50m</p>
      <h2>潜ってきた<br />航路。</h2>
    </div>
    <ol class="profile-timeline__list">
      {
        profileTimeline.map((item, index) => (
          <li class="profile-timeline__item">
            <div class="profile-timeline__marker" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </div>
            <div>
              <p class="profile-timeline__stage">{item.stage}</p>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
