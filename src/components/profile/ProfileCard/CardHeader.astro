---
import { Icon } from "astro-iconify";
import { baseProfile, affilicationList } from "./data";
import Link from "@components/Link.astro";
---

<div class="px-5 pt-8 pb-5">
  <div class="flex items-start gap-5">
    <img
      class="size-18 rounded-full"
      src="/tim-bird.png"
      alt="鳥のプロフィールアイコン"
    />
    <div>
      <p class="text-lg">{baseProfile.handleName}</p>
      <h2 class="text-2xl">{baseProfile.name}</h2>
    </div>
  </div>

  <div class="mt-3 mx-1 p-3 bg-gray-light text-sm rounded-2xl rounded-tl-none">
    {baseProfile.bio}
  </div>

  <div class="pl-2 pt-4 flex flex-col gap-1 items-start">
    {
      affilicationList.map((affilication) => (
        <Link
          href={affilication.href}
          className="text-base flex items-start gap-3"
        >
          <Icon name={affilication.iconName} class="mt-1 size-5 shrink-0" />
          <p class="text-primary-blue underline line-clamp-1">
            {affilication.name}
          </p>
        </Link>
      ))
    }
  </div>
</div>
