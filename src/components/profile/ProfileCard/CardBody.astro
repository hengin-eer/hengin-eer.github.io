---
import ContactButton from "@components/button/ContactButton.astro";
import { snsProfileList } from "./data";
import SnsProfileButton from "./SnsProfileButton.astro";
---

<div class="pb-6">
  <div class="px-8 grid grid-cols-4">
    {snsProfileList.map((item) => <SnsProfileButton {...item} />)}
  </div>

  <div class="pt-5 grid place-items-center">
    <ContactButton />
  </div>
</div>
