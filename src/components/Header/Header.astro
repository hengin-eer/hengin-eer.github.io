---
import { SITE_TITLE } from "src/constant/SITE";
const isProfilePage = Astro.url.pathname === "/profile/";
---

<header
  class="h-16 sm:h-20 w-full px-4 sm:px-8 lg:px-14 flex items-center justify-between gap-3"
>
  <h1 class="min-w-0 text-2xl sm:text-3xl text-primary-blue font-averia">
    <a href="/" class="block truncate">{SITE_TITLE}</a>
  </h1>
  <nav class="shrink-0 flex items-center" aria-label="主要ナビゲーション">
    <a
      href="/profile"
      class="h-12 sm:h-14 p-1 pr-4 sm:pr-6 flex items-center gap-2 sm:gap-3 font-comfortaa text-base sm:text-lg text-primary-blue border-2 border-primary-blue rounded-full transition-colors duration-200 hover:bg-primary-blue/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ocean-deep aria-[current=page]:bg-ocean-deep aria-[current=page]:border-ocean-deep aria-[current=page]:text-white"
      aria-current={isProfilePage ? "page" : undefined}
    >
      <img
        class="profile-bird size-9 sm:size-11 shrink-0 rounded-full object-cover"
        src="/tim-bird.png"
        alt=""
        width="48"
        height="48"
      />
      Profile
    </a>
  </nav>
</header>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .profile-bird {
      animation: bird-hop 1.6s ease-in-out infinite;
    }
  }

  @keyframes bird-hop {
    0%,
    20%,
    40%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    10% {
      transform: translateY(-4px) rotate(-12deg);
    }
    30% {
      transform: translateY(-4px) rotate(12deg);
    }
  }
</style>
