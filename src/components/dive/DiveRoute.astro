---
import { diveMilestones } from "../../data/dive";

const { id = "route" } = Astro.props;
---

<section id={id} class="dive-section dive-route" data-ocean-depth="0.48">
  <div class="dive-section__inner">
    <div class="dive-section__heading">
      <p class="dive-eyebrow">OPEN WATER / 50m</p>
      <h2>潜ってきた<br />航路。</h2>
    </div>
    <ol class="dive-route__list">
      {
        diveMilestones.map((item, index) => (
          <li class="dive-route__item">
            <div class="dive-route__marker" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </div>
            <div>
              <p class="dive-route__stage">{item.stage}</p>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .dive-section {
    position: relative;
    display: grid;
    align-items: center;
    min-height: min(100svh, 900px);
    padding: clamp(5rem, 12vw, 10rem) 1.25rem;
    scroll-margin-top: 5rem;
  }

  .dive-section::before {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, rgba(5, 18, 45, 0.42), transparent 65%);
    content: "";
    pointer-events: none;
  }

  .dive-section__inner {
    position: relative;
    width: min(100%, 1100px);
    margin: 0 auto;
  }

  .dive-eyebrow {
    margin-bottom: 1rem;
    color: #aaf8de;
    font-family: "Comfortaa Variable", sans-serif;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  .dive-section h2,
  .dive-section h3 {
    font-family: "Shippori Antique B1", sans-serif;
    font-weight: 400;
  }

  .dive-section h2 {
    font-size: clamp(2.2rem, 6vw, 4.8rem);
    line-height: 1.12;
    letter-spacing: -0.04em;
  }

  .dive-route {
    background: linear-gradient(
      145deg,
      rgba(9, 66, 123, 0.42),
      rgba(6, 31, 74, 0.56)
    );
  }

  .dive-section__heading {
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }

  .dive-route__list {
    display: grid;
    gap: 2rem;
    list-style: none;
  }

  .dive-route__item {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding-top: 1.4rem;
    border-top: 1px solid rgba(211, 239, 255, 0.28);
  }

  .dive-route__marker,
  .dive-route__stage {
    color: #aaf8de;
    font-family: "Fira Code", monospace;
    font-size: 0.76rem;
  }

  .dive-route__item h3 {
    margin-bottom: 0.65rem;
    font-size: clamp(1.25rem, 2vw, 1.7rem);
  }

  .dive-route__stage {
    margin-bottom: 0.3rem;
    letter-spacing: 0.12em;
  }

  .dive-route__item > div > p:not(.dive-route__stage) {
    max-width: 38rem;
    font-size: clamp(1rem, 1.45vw, 1.17rem);
    line-height: 2;
  }

  @media (min-width: 768px) {
    .dive-section {
      padding-right: clamp(6rem, 13vw, 12rem);
      padding-left: clamp(2rem, 9vw, 8rem);
    }
  }
</style>
