---
import Layout from "src/layouts/Layout.astro";
import { ProfileCard } from "@components/profile/ProfileCard";
---

<Layout
  title="Profile"
  description="Hiroki Tomoda(@timdaik)のデジタルプロフィールカードです。このカードから各種SNSを通じてコンタクトが取れます。"
  footerTone="ocean"
>
  <main>
    <section class="profile-backdrop py-20 grid place-items-center">
      <ProfileCard />
    </section>
  </main>
</Layout>

<style>
  .profile-backdrop {
    background:
      radial-gradient(
        60% 42% at 50% 40%,
        color-mix(in oklab, var(--ocean-bioluminescent) 30%, transparent),
        transparent 72%
      ),
      radial-gradient(
        48% 36% at 88% 6%,
        color-mix(in oklab, var(--primary-blue) 38%, transparent),
        transparent 70%
      ),
      linear-gradient(
        to bottom,
        var(--ocean-mid),
        var(--ocean-deep) 38%,
        var(--ocean-indigo) 70%,
        var(--ocean-abyss)
      );
  }
</style>
