---
import Layout from "src/layouts/Layout.astro";
import DiveExperience from "../../components/dive/DiveExperience";
import DiveOrigins from "../../components/dive/DiveOrigins.astro";
import DiveOpening from "../../components/dive/DiveOpening.astro";
import DiveConnections from "../../components/dive/DiveConnections.astro";
import DiveRoute from "../../components/dive/DiveRoute.astro";
import DivePrinciples from "../../components/dive/DivePrinciples.astro";
---

<Layout
  title="DIVE"
  description="Hiroki Tomoda / timdaik の関心と制作の航路を、海へ潜るようにたどるストーリー。"
>
  <DiveExperience client:load />
  <main class="dive-story-page">
    <DiveOpening />
    <DiveOrigins />
    <DiveRoute />
    <DivePrinciples />
    <DiveConnections />
  </main>
</Layout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  .dive-story-page {
    position: relative;
    z-index: 1;
    overflow: clip;
    color: #f7fbff;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }
</style>
