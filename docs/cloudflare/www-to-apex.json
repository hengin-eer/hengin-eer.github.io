{
  "name": "Redirect www to apex",
  "kind": "zone",
  "phase": "http_request_dynamic_redirect",
  "rules": [
    {
      "ref": "www_to_apex",
      "description": "Redirect www.hiro-to.moda to hiro-to.moda",
      "expression": "http.host eq \"www.hiro-to.moda\"",
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "target_url": {
            "expression": "concat(\"https://hiro-to.moda\", http.request.uri.path)"
          },
          "status_code": 301,
          "preserve_query_string": true
        }
      },
      "enabled": true
    }
  ]
}
