{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hiro-to-moda",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  // apex を Custom Domain として割り当てる。CI の deploy は既存の DNS レコードを上書きする。
  "routes": [{ "pattern": "hiro-to.moda", "custom_domain": true }],
  // 切り替え後の確認と切り戻しに使うため、安定するまで workers.dev も残す。
  "workers_dev": true,
  "preview_urls": true,
}
